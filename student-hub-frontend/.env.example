# API base URL.
# Development: a relative path so the Vite dev server proxies requests to
# the backend (see vite.config.ts). This keeps the browser on a single
# origin, which is required for cookies + CSRF to work correctly.
#
# Production: set to the deployed backend path, e.g. /api/v1 (assuming a
# reverse proxy serves the frontend and API on the same domain).
VITE_API_URL=/api/v1
